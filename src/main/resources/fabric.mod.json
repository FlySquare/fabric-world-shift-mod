{
	"schemaVersion": 1,
	"id": "change-world-every-second",
	"version": "${version}",
	"name": "World Shift",
	"description": "Periodically shifts players between worlds with a countdown-driven gameplay loop.",
	"authors": [
		"Flyzen"
	],
	"license": "MIT",
	"icon": "assets/change-world-every-second/icon.png",
	"contact": {
		"sources": "https://github.com/FlySquare/fabric-world-shift-mod",
		"issues": "https://github.com/FlySquare/fabric-world-shift-mod/issues",
		"homepage": "https://github.com/FlySquare/fabric-world-shift-mod"
	},
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.flyzen.changeworldeverysecond.WorldShift"
		],
		"client": [
			"com.flyzen.changeworldeverysecond.client.WorldShiftClient"
		]
	},
	"mixins": [
		"change-world-every-second.mixins.json",
		{
			"config": "change-world-every-second.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
